# OpenAI API Key (required for live AI mode)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# AI Mode: "true" for offline mock responses, "false" for live OpenAI
MOCK_AI=true

# Flask settings
FLASK_SECRET_KEY=dev-secret-key-change-in-production
FLASK_DEBUG=1

# Database path (defaults to app/server/dogshelter.db)
# DATABASE_PATH=/path/to/database.db
